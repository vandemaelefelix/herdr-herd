name = Sheep

# Slim status sprites: 12x5, drawn 1 px shorter than the 6 px band and
# bottom-anchored, so the hop/shake lift stays inside the strip. idle = a
# lying-down doze (sits low); working = a two-frame walk; done/blocked/unknown
# stand. Head + face (eye e, snout p) on the right; woolly L->M->S body.

[idle]    frame_ms=520 motion=breathe overlay=bubble:Zz
............
..####.###..
.#LMMMM#ep#.
#SSSSSSS#p#.
............

[working] frame_ms=150 motion=hop+wander overlay=none
..####.####.
#LLLLL#pep#.
#MMMMM#ppp#.
.#SSSS#pp#..
..p.p.p.p...

..####.####.
#LLLLL#pep#.
#MMMMM#ppp#.
.#SSSS#pp#..
.p.p.p.p....

[done]    frame_ms=1400 motion=hop overlay=badge:! color=accent
..####.####.
#LLLLL#pep#.
#MMMMM#ppp#.
.#SSSS#pp#..
..p.p.p.p...

[blocked] frame_ms=120 motion=shake overlay=badge:! color=#e62d23
..####.####.
#LLLLL#pep#.
#MMMMM#ppp#.
.#SSSS#pp#..
..p.p.p.p...

[unknown] frame_ms=0 motion=sway overlay=bubble:? ghost=true
..####.####.
#LLLLL#pep#.
#MMMMM#ppp#.
.#SSSS#pp#..
..p.p.p.p...
