name = Goat

# Same side-view poses as the sheep, with a horn (h) sweeping back from the head
# so the two species read apart at a glance. idle = dozing (lying); working =
# two-frame hop cycle (airborne legs hand-extended into a diagonal running
# stride, same shape as the sheep's — the horns already fill the top row's
# headroom, so unlike the sheep this pose doesn't also lift the body);
# done/blocked/unknown = standing. All frames 16x14.

[idle]    frame_ms=520 motion=breathe overlay=bubble:Zz
