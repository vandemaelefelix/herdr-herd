name = Goat

# Same slim 12x5 poses as the sheep, with a horn (h) on the head so the two
# species read apart. idle = lying doze; working = walk; others stand.

[idle]    frame_ms=520 motion=breathe overlay=bubble:Zz
............
.......hh...
..####.###..
.#LMMMM#ep#.
#SSSSSSS#p#.

[working] frame_ms=150 motion=hop+wander overlay=none
..####.hh#..
#LLLLL#pep#.
#MMMMM#ppp#.
.#SSSS#pp#..
..p.p.p.p...

..####.hh#..
#LLLLL#pep#.
#MMMMM#ppp#.
.#SSSS#pp#..
.p.p.p.p....

[done]    frame_ms=1400 motion=hop overlay=badge:! color=accent
..####.hh#..
#LLLLL#pep#.
#MMMMM#ppp#.
.#SSSS#pp#..
..p.p.p.p...

[blocked] frame_ms=120 motion=shake overlay=badge:! color=#e62d23
..####.hh#..
#LLLLL#pep#.
#MMMMM#ppp#.
.#SSSS#pp#..
..p.p.p.p...

