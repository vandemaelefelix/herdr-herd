name = Goat

# Same side-view poses as the sheep, with a horn (h) sweeping back from the head
# so the two species read apart at a glance. idle = dozing (lying); working =
# walk cycle; done/blocked/unknown = standing. All frames 16x14.

[idle]    frame_ms=520 motion=breathe overlay=bubble:Zz
